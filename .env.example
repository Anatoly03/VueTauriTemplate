#! === Example Environment Files ===

# Sets environment variable "$DISPLAY". For multiple-display environments
# as well as headless environments with a virtual display, this allows to
# specify the correct display.
# DISPLAY=":0"

# Base Github URL for the application. This is used for generating links
# like bug reports and documentation.
GITHUB_REMOTE = "https://github.com/Anatoly03/VueTauriTemplate"

# Base Github API URL for the application releases. This is used for
# fetching for new releases and updates.
GITHUB_RELEASES = "https://api.github.com/repos/Anatoly03/VueTauriTemplate/releases"
